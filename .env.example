# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=
# Group/chat where booking leads are forwarded (add the bot to it). Negative number for groups.
ADMIN_CHAT_ID=
# Optional
DB_PATH=ezoz.db
MENU_PDF_PATH=assets/ezoz_menu.pdf
WEBSITE_URL=

# --- Cross-posting: Meta Graph API (Instagram + Facebook) ---
GRAPH_VERSION=v21.0
IG_USER_ID=
META_ACCESS_TOKEN=
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Folder served over HTTPS by your web server; Meta downloads media from this public URL.
MEDIA_DIR=media_tmp
PUBLIC_MEDIA_BASE_URL=

# --- YouTube Data API (Shorts) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Contacts screen (all optional) ---
ADDRESS=
PHONE=
INSTAGRAM_URL=
TELEGRAM_CHANNEL_URL=
FACEBOOK_URL=
# Language of the booking notifications sent to staff: en, ru or uz
ADMIN_LANG=ru
LOGO_PATH=assets/logo.jpg
