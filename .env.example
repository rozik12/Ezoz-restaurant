# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=
# Google AI Studio key (aistudio.google.com/apikey). Used first when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# DeepSeek key from platform.deepseek.com. Used when no Gemini key is set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional fallback provider, used only when neither of the keys above is set
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Telegram user ids of owners, comma separated (use /id in the bot to see yours)
ADMIN_IDS=
# Telegram usernames (no @) that become administrators on their first message to the bot
ADMIN_USERNAMES=artyomglupech
MAX_TOKENS=8000
DB_PATH=omnistudent.db

# Wallet: every action is paid from the user's balance in Telegram Stars
PRICE_CHAT=50
PRICE_SLIDES=50
PRICE_DETECT=50
PRICE_CONVERT=50
# Top-up buttons (any other amount from 1 Star can be typed in)
TOPUP_PRESETS=50,100,250,500,1000
TOPUP_MAX=10000
# Stars given to a new user (0 = none)
WELCOME_BONUS=0

# Top-up for users whose cards do not work with Telegram Stars (all optional)
# Price of one Star in so'm
UZS_PER_STAR=
# Transfer to a card: shown to the user, the admin confirms the receipt in the bot
CARD_NUMBER=
CARD_HOLDER=
# Click / Payme token from BotFather (Bot Settings > Payments); needs a registered merchant account
PAYMENT_PROVIDER_TOKEN=
SUPPORT_CONTACT=
