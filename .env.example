# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=
# Google AI Studio key (aistudio.google.com/apikey). Used first when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# DeepSeek key from platform.deepseek.com (API keys). This is the default provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional fallback provider, used only when DEEPSEEK_API_KEY is empty
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Telegram user ids of administrators, comma separated (use /id in the bot to see yours)
ADMIN_IDS=
# Telegram usernames (no @) that become administrators on their first message to the bot
ADMIN_USERNAMES=artyomglupech
# Limits
# Free tools per day (separate from chat requests; subscribers get triple)
SLIDES_DAILY=3
DETECT_DAILY=5
CONVERT_DAILY=30
FREE_DAILY=5
PAID_DAILY=100
FREE_MAX_TOKENS=1800
PAID_MAX_TOKENS=8000
# Subscription paid in Telegram Stars
PRICE_STARS=300
SUB_DAYS=30
DB_PATH=omnistudent.db
SUPPORT_CONTACT=

# Payment for users whose cards do not work with Telegram Stars (all optional)
# Price of one subscription period in so'm
PRICE_UZS=
# Transfer to a card: shown to the user, the admin confirms the receipt in the bot
CARD_NUMBER=
CARD_HOLDER=
# Click / Payme token from BotFather (Bot Settings > Payments); needs a registered merchant account
PAYMENT_PROVIDER_TOKEN=
